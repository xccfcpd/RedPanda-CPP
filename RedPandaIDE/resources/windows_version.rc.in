#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @REDPANDA_WINDOWS_FILEVERSION@
 PRODUCTVERSION @REDPANDA_WINDOWS_FILEVERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS @REDPANDA_WINDOWS_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Red Panda C++"
            VALUE "FileDescription", "Red Panda C++ IDE"
            VALUE "FileVersion", "@REDPANDA_VERSION@"
            VALUE "InternalName", "RedPandaIDE"
            VALUE "LegalCopyright", "Copyright (C) 2020-2026 Roy Qu"
            VALUE "OriginalFilename", "RedPandaIDE.exe"
            VALUE "ProductName", "Red Panda C++"
            VALUE "ProductVersion", "@REDPANDA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
